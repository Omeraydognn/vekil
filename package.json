{
  "name": "vekil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VEKİL: an autonomous AVAX-TRY spot agent whose rules live in an Avalanche contract",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "dev": "tsx src/main.ts",
    "verify": "tsx scripts/verify.ts",
    "audit:orders": "tsx scripts/audit-orders.ts",
    "guard": "tsx scripts/guard.ts",
    "kill": "tsx scripts/kill.ts",
    "live": "tsx scripts/live.ts",
    "resume": "tsx scripts/resume.ts",
    "abi:sync": "forge build --root contracts && tsx scripts/abi-sync.ts",
    "chain:fuji": "tsx scripts/deploy.ts --chain fuji",
    "chain:mainnet": "tsx scripts/deploy.ts --chain mainnet",
    "policy:set": "tsx scripts/policy-set.ts",
    "owner:pause": "tsx scripts/owner-pause.ts",
    "register-agent": "tsx scripts/register-agent.ts",
    "atk:probe": "tsx scripts/atk-probe.ts",
    "atk:lock": "tsx scripts/atk-probe.ts --write-lock",
    "probe:market": "tsx scripts/probe-market.ts",
    "probe:agent": "tsx scripts/probe-agent.ts",
    "probe:policy": "tsx scripts/probe-policy.ts",
    "probe:chain": "tsx scripts/probe-chain.ts",
    "evidence": "tsx scripts/evidence.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@okx_ai/okx-trade-mcp": "1.4.8",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
