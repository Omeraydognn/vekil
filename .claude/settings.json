{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm smoke)",
      "Bash(pnpm i)",
      "Bash(pnpm install)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm atk:probe)",
      "Bash(pnpm atk:lock)",
      "Bash(pnpm probe:market)",
      "Bash(pnpm probe:agent)",
      "Bash(pnpm probe:policy)",
      "Bash(pnpm verify)",
      "Bash(pnpm verify *)",
      "Bash(pnpm audit:orders)",
      "Bash(pnpm abi:sync)",
      "Bash(forge build)",
      "Bash(forge build *)",
      "Bash(forge test)",
      "Bash(forge test *)",
      "Bash(forge fmt *)",
      "Bash(anvil --version)",
      "Bash(cast call *)",
      "Bash(npm ls -g @okx_ai/okx-trade-mcp*)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "mcp__okx-readonly"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(git push *)",
      "Bash(pnpm kill*)",
      "Bash(pnpm chain:fuji*)",
      "Bash(pnpm policy:set*)",
      "Bash(pnpm owner:pause*)",
      "Bash(pnpm register-agent*)",
      "Bash(pnpm probe:chain*)",
      "Bash(forge script *)",
      "Bash(forge create *)",
      "Bash(cast send *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(//**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(//**/.env)",
      "Edit(./**/.env.local)",
      "Read(//**/vekil-live/**)",
      "Edit(//**/vekil-live/**)",
      "Read(~/.okx/**)",
      "Edit(~/.okx/**)",
      "Bash(cat .env*)",
      "Bash(cat ~/.okx*)",
      "Bash(printenv*)",
      "Bash(okx *)",
      "Bash(okx-trade-mcp *)",
      "Bash(npx @okx_ai/okx-trade-mcp*)",
      "Bash(cd ../vekil-live*)",
      "Bash(git -C ../vekil-live*)",
      "Bash(EXECUTION_MODE=live*)",
      "Bash(EXECUTION_MODE=demo*)",
      "Bash(CHAIN=mainnet*)",
      "Bash(EXECUTOR_ARM_TOKEN*)",
      "Bash(tsx src/executor*)",
      "Bash(npx tsx src/executor*)",
      "Bash(pnpm exec tsx src/executor*)",
      "Bash(pnpm live*)",
      "Bash(pnpm run live*)",
      "Bash(npm run live*)",
      "Bash(tsx scripts/live*)",
      "Bash(npx tsx scripts/live*)",
      "Bash(pnpm exec tsx scripts/live*)",
      "Bash(pnpm resume*)",
      "Bash(pnpm run resume*)",
      "Bash(tsx scripts/resume*)",
      "Bash(pnpm chain:mainnet*)",
      "Bash(pnpm run chain:mainnet*)"
    ]
  }
}
