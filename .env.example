# VEKİL environment. Copy to .env and fill it in yourself. Claude Code never reads .env.
# Process environment overrides .env, e.g.  EXECUTION_MODE=fake LLM_PROVIDER=scripted CHAIN=local pnpm dev
# Empty values count as unset.
#
# Two kinds of .env:
#   dev  (vekil/ and track worktrees): DEV wallets, PORT=8788, EXECUTOR_PORT=8790, EXECUTION_MODE=paper
#   live (../vekil-live only):          LIVE wallets, PORT=8787, EXECUTOR_PORT=8789, EXECUTION_MODE=live, CHAIN=fuji

# ---- modes ----
EXECUTION_MODE=paper            # fake | paper | demo | live   (demo/live start only via `pnpm live`, human only)
LLM_PROVIDER=anthropic          # anthropic | openrouter | scripted   (demo/live require a real LLM: anthropic or openrouter)
CHAIN=fuji                      # fake | local (anvil) | fuji | mainnet   (demo/live require fuji or mainnet)
DATA_DIR=                       # empty = data/<EXECUTION_MODE>-<CHAIN>; fake/local data is wiped on start
INST_ID=AVAX-TRY
STRATEGY_PROFILE=standard       # standard (1H regime + 15m entries) | active (15m regime + 5m entries)

# ---- OKX Agent Trade Kit ----
# API keys live ONLY in ~/.okx/config.toml profiles (see the ATK README). Never put them here.
ATK_READ_PROFILE=tr-read        # read-only key (core, agent, live auditor; executor price/balance reads)
ATK_READ_MODULES=market,account,spot   # core's read instance + atk:probe/lock; keep identical to .mcp.json; add news only after it's verified on TR
ATK_TRADE_PROFILE=tr-trade      # read + trade, NO withdraw; used ONLY by the live executor (modules market,spot)
ATK_DEMO_PROFILE=tr-demo        # only if OKX TR demo trading is verified (S9)
FEE_RATE=0.0022                 # verified AVAX-TRY taker fee on OKX TR (ATK_NOTES, 17 Oct): 0.22 %
PAPER_START_QUOTE=1000          # starting TRY balance for fake/paper

# ---- local preflight (market sanity + soft discipline; the owner's rules are on-chain) ----
MAX_SPREAD_PCT=0.3
PRICE_COLLAR_PCT=1
MAX_SNAPSHOT_AGE_SEC=15
COOLDOWN_AFTER_LOSS_MIN=60

# ---- LLM ----
ANTHROPIC_API_KEY=              # required if LLM_PROVIDER=anthropic
OPENROUTER_API_KEY=             # required if LLM_PROVIDER=openrouter (https://openrouter.ai/keys)
LLM_MODEL=claude-sonnet-5-5     # anthropic model id; with openrouter an OpenRouter id that supports tools, e.g. <vendor>/<model>:free
LLM_BASE_URL=                   # optional gateway: Anthropic-compatible (with LLM_PROVIDER=anthropic) or OpenAI-compatible
                                # (with LLM_PROVIDER=openrouter, URL ending before /chat/completions). Put its key in the matching *_API_KEY.
LLM_MAX_TOOL_CALLS=8
LLM_CYCLE_TIMEOUT_SEC=60
LLM_MAX_CYCLES_PER_HOUR=20

# ---- Avalanche ----
LOCAL_RPC_URL=http://127.0.0.1:8545
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
MAINNET_RPC_URL=https://api.avax.network/ext/bc/C/rpc
AGENT_PRIVATE_KEY=              # required if CHAIN is fuji/mainnet (fake/local use anvil account 1). Signs requestApproval/recordExit/anchor. dev and live use DIFFERENT wallets.
OWNER_PRIVATE_KEY=              # owner actions: deploy, setPolicy, pause/unpause, register-agent (demo convenience; S1 = browser wallet). dev and live DIFFERENT.
VEKIL_POLICY_ADDRESS=           # optional override; normally read from $DATA_DIR/deployment.json
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e   # Fuji; verify before use

# ---- servers and loops ----
HOST=127.0.0.1                  # must stay loopback (core and executor)
PORT=8788                       # core. dev default 8788; live (../vekil-live) MUST set 8787 (pnpm live checks)
EXECUTOR_PORT=8790              # executor. dev default 8790; live MUST set 8789
MONITOR_INTERVAL_SEC=10
CHAIN_WATCH_INTERVAL_SEC=3
ANCHOR_INTERVAL_MIN=60

# ---- human acknowledgements ----
I_CONFIRM_NO_WITHDRAW=          # live requires "yes" (after YOU checked on OKX TR that the trade key has no withdraw permission)
